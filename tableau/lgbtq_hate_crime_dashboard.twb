      <aliases enabled='yes' />
      <column caption='Avg Severity' datatype='real' name='[AVG_SEVERITY]' role='measure' type='quantitative' />
      <column caption='[Law Level Label]' datatype='string' name='[Calculation_3167800454250500]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [LAW_LEVEL] = &quot;2&quot; THEN &quot;Full Protection&quot;&#10;ELSEIF [LAW_LEVEL] = &quot;1&quot; THEN &quot;SO Only&quot;&#10;ELSEIF [LAW_LEVEL] = &quot;0&quot; THEN &quot;No Law&quot;&#10;ELSE &quot;Unknown&quot;&#10;END' />
      </column>
      <column caption='[Law Level Order]' datatype='integer' name='[Calculation_3167800454344709]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [LAW_LEVEL] = &quot;0&quot; THEN 1&#10;ELSEIF [LAW_LEVEL] = &quot;1&quot; THEN 2&#10;ELSEIF [LAW_LEVEL] = &quot;2&quot; THEN 3&#10;ELSE 4&#10;END' />
      </column>
      <column caption='[Active Rate]' datatype='real' name='[Calculation_3167800454389766]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3167800453713923] = &quot;Per 100K Total Pop&quot;&#10;THEN [RATE_PER_100K_TOTAL]&#10;ELSE [RATE_PER_100K_LGBT]&#10;END' />
      </column>
      <column caption='[Violent Pct Label]' datatype='string' name='[Calculation_3167800454807559]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([VIOLENT_PCT] * 100, 1)) + &quot;%&quot;' />
      </column>
      <column caption='[Rate Availability Flag]' datatype='string' name='[Calculation_3167800454860808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3167800453713923] = &quot;Track 2 — Per 100K LGBT Pop (2012+)&quot;&#10;   AND YEAR([DATA_YEAR]) &lt; 2012&#10;THEN &quot;⚠ No LGBT pop data pre-2012&quot;&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='[In Selected Year]' datatype='boolean' name='[Calculation_3167800454901769]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR([DATA_YEAR]) = [Parameters].[Parameter 3167800450805760]' />
      </column>
      <column caption='[YoY Change]' datatype='real' name='[Calculation_3167800454934538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOOKUP(SUM([INCIDENTS]), -1) = 0 THEN NULL&#10;ELSE (SUM([INCIDENTS]) - LOOKUP(SUM([INCIDENTS]), -1))&#10;     / ABS(LOOKUP(SUM([INCIDENTS]), -1))&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='[Gini Tier]' datatype='string' name='[Calculation_3167800455831563]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [GINI_COEFFICIENT] &lt; 0.45 THEN &quot;Low Inequality&quot;&#10;ELSEIF [GINI_COEFFICIENT] &lt; 0.50 THEN &quot;Medium Inequality&quot;&#10;ELSE &quot;High Inequality&quot;&#10;END' />
      </column>
      <column caption='[Violent Share]' datatype='real' name='[Calculation_3167800464904209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([VIOLENT_COUNT]) / SUM([INCIDENTS])' />
      </column>
      <column caption='[States With Law]' datatype='integer' name='[Calculation_3167800467066898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [LAW_LEVEL] &lt;&gt; &quot;0&quot; AND [LAW_LEVEL] &lt;&gt; &quot;NA&quot; THEN [STATE_NAME] END)' />
      </column>
      <column caption='Data Year' datatype='date' name='[DATA_YEAR]' role='dimension' type='quantitative' />
      <column caption='Gini Coefficient' datatype='real' name='[GINI_COEFFICIENT]' role='measure' type='quantitative' />
      <column caption='Hc Law Gi' datatype='integer' name='[HC_LAW_GI]' role='measure' type='quantitative' />
      <column caption='Hc Law So' datatype='integer' name='[HC_LAW_SO]' role='measure' type='quantitative' />
